<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off"
      internalLogFile="logs\nlog-internal.log">

  <!-- 로그 출력 대상 정의 -->
  <targets>
    <!-- 파일 로그: 날짜별 롤링 -->
    <target xsi:type="File"
            name="fileTarget"
            fileName="logs\svnaiclient-${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true:padding=5} | ${logger:shortName=true} | ${message} ${exception:format=tostring}"
            encoding="utf-8"
            keepFileOpen="false"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="30" />

    <!-- 콘솔 로그 (디버그 빌드용) -->
    <target xsi:type="Console"
            name="consoleTarget"
            layout="${time} | ${level:uppercase=true:padding=5} | ${logger:shortName=true} | ${message} ${exception:format=tostring}" />

    <!-- 별도 에러 로그 파일 -->
    <target xsi:type="File"
            name="errorFileTarget"
            fileName="logs\svnaiclient-error-${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message}${newline}${exception:format=tostring}"
            encoding="utf-8" />
  </targets>

  <!-- 로그 규칙 -->
  <rules>
    <!-- Debug 이상 → 파일 출력 -->
    <logger name="*" minlevel="Debug" writeTo="fileTarget" />

    <!-- Error 이상 → 에러 전용 파일 출력 -->
    <logger name="*" minlevel="Error" writeTo="errorFileTarget" />

    <!-- Debug 빌드에서는 콘솔 출력도 활성화 -->
    <!-- <logger name="*" minlevel="Trace" writeTo="consoleTarget" /> -->
  </rules>
</nlog>
